# SW4 SCRIPT

fileio path=output pfs=1 verbose=1 printcycle=10 nwriters=16

# GRID SIZE AND REFINEMENT
#grid x=30000 y=15000 z=30000 h=100.0 lat=39.111563 lon=-122.569504 az=143.638 proj=tmerc datum=NAD83 lon_p=-123.0 lat_p=35.0 scale=0.9996
#grid x=1000 y=1000 z=5000 h=10.0 

grid x=79000 y=93000 z=25000 h=100 lat=33.6 lon=-118.4 az=0 proj=tmerc datum=NAD83 lon_p=-118.0 lat_p=34.0 scale=0.9996


supergrid gp=30
time t=1.0 utcstart=01/01/2021:00:00:00.0

globalmaterial vsmin=250 vpmin=500
attenuation phasefreq=1.0 nmech=3 maxfreq=10.0

