## ORNL frontier
 
FC = gfortran
CXX = mpicxx

proj=yes
hdf5=yes
SW4ROOT = ${UCVM_INSTALL_PATH}/lib/proj
SQL3ROOT = ${UCVM_INSTALL_PATH}/lib/sqlite
HDF5ROOT = ${UCVM_INSTALL_PATH}/lib/hdf5

EXTRA_LINK_FLAGS = -L${OLCF_OPENBLAS_ROOT}/lib -lopenblas -L${GCC_PREFIX}/snos/lib64 -lgfortran

