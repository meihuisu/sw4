## FOR TACC Frontera

FC = gfortran
CXX = mpicxx

proj=yes
hdf5=yes

SW4ROOT = ${TACC_PROJ_DIR}
SQL3ROOT = ${TACC_SQLITE_DIR} 
HDF5ROOT = ${TACC_PHDF5_DIR}

EXTRA_CXX_FLAGS  = -fopenmp -I$MKLROOT/include
EXTRA_FORT_FLAGS =
EXTRA_LINK_FLAGS = -L${UCVM_INSTALL_PATH}/lib/openssl/lib -lcrypto -lssl -Wl,-L${MKLROOT}/lib/intel64 -lmkl_intel_lp64 -lmkl_core -lmkl_gnu_thread -lpthread -lm -ldl -L${GCC_LIB} -lgfortran                                                           

